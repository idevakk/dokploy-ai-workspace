# ==========================================
# PAPERCLIP SETTINGS
# ==========================================
# Set COMPOSE_PROFILES to conditionally install services.
# Use 'paperclip' for Paperclip, '9router' for 9Router. Comma separate for both (e.g. paperclip,9router).
COMPOSE_PROFILES=paperclip,9router
# Domain settings
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
PAPERCLIP_ALLOWED_HOSTNAMES=paperclip.example.com,localhost
# Generate a random 32-character hex string for Better Auth
BETTER_AUTH_SECRET=A_RANDOM_32_CHAR_HEX_SECRET_STRING
# Your database password
POSTGRES_PASSWORD=secretdbpass
# API Keys for AI models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# OMNIROUTER SETTINGS
# ==========================================
# Domain settings
OMNI_PUBLIC_BASE_URL=https://omniroute.example.com
OMNI_WS_ALLOWED_ORIGINS=https://omniroute.example.com,http://localhost:20130
OMNI_WS_PUBLIC_URL=wss://omniroute.example.com
OPENROUTER_API_KEY=
# Security Secrets (Generate via: openssl rand -hex 32)
OMNI_JWT_SECRET=9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
OMNI_API_KEY_SECRET=0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a089f86d081884c7d659a2fea
OMNI_WS_BRIDGE_SECRET=4f1b2b0b822cd15d6c15b0f00a089f86d081884c7d659a2feaa0c55ad015a3bf
OMNI_PASSWORD=StrongAdminPass2026!

# ==========================================
# OPENCODE SETTINGS
# ==========================================
GH_TOKEN=
OPENCODE_PASSWORD=opencodeWebPass!

# ==========================================
# 9ROUTER SETTINGS
# ==========================================
NINEROUTER_PUBLIC_URL=https://9router.example.com
